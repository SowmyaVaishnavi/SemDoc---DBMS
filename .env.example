# Copy to .env.local and fill in. .env.local is git-ignored; never commit it.
# Database container (migration / owner account)
POSTGRES_USER=semdoc_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=semdoc

# Password for the least-privilege role app_user (the Next.js app connects as this one)
APP_DB_PASSWORD=change-me-too

# Used by the Next.js app
DATABASE_URL=postgresql://app_user:change-me-too@localhost:5433/semdoc
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
